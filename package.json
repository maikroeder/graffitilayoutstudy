{
  "name": "graffiti",
  "version": "0.0.1",
  "repository": "https://code.interaktiv.de/interaktiv/graffiti",
  "license": "UNLICENSED",
  "devDependencies": {
    "@mojotech/raml2html-slate-theme": "^2.3.2",
    "api-designer": "^0.4.1",
    "blueimp-tmpl": "^3.11.0",
    "grunt": "~1.0.2",
    "grunt-cli": "^1.2.0",
    "grunt-contrib-clean": "^1.1.0",
    "grunt-contrib-less": "^1.4.1",
    "grunt-contrib-uglify": "^2.0.0",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-file-creator": "^0.1.3",
    "grunt-notify": "^0.4.5",
    "raml2html": "^7.3.0",
    "lesshat": "^4.1.0"
  },
  "dependencies": {
    "ajaxq": "^0.0.7",
    "animate.css": "^3.6.1",
    "bootstrap": "3.4.1",
    "bootstrap-select": "1.13.18",
    "bootstrap-typeahead": "^2.3.2",
    "dropzone": "5.7.2",
    "jquery-ui": "^1.12.1",
    "leaflet": "^1.6.0",
    "leaflet-geosearch": "^2.7.0",
    "leaflet-path-transform": "^1.1.3",
    "license-checker": "^25.0.1",
    "puppeteer": "^1.18.0",
    "rellax": "^1.5.1",
    "slick-carousel": "^1.8.1",
    "tablesorter": "2.29.0",
    "tinyColorPicker": "git+https://github.com/PitPik/tinyColorPicker.git",
    "toastr": "^2.1.4",
    "wow.js": "^1.2.2",
    "jquery-lazy": "^1.7.10",
    "jquery.cookie": "^1.4.1"
  },
  "scripts": {
    "preinstall": "npm run get_package && npm run interaktiv-merge",
    "get_package": "test -x node_modules/package-json-interaktiv-merge/bin/package-json-interaktiv-merge || (rm -rf node_modules/package-json-interaktiv-merge && git clone git@code.interaktiv.de:interaktiv-public/package-json-interaktiv-merge.git node_modules/package-json-interaktiv-merge && chmod +x node_modules/package-json-interaktiv-merge/bin/package-json-interaktiv-merge && npm install --prefix node_modules/package-json-interaktiv-merge --no-audit --no-fund --production)",
    "install_global_packages": "sudo npm i -g grunt-cli",
    "interaktiv-merge": "./node_modules/package-json-interaktiv-merge/bin/package-json-interaktiv-merge ./package.json ./src/*/package.json",
    "license-generator": "license-checker --csv --out ./var/licenses-node.csv"
  },
  "interaktiv_setup": {
    "theme_package": "graffiti.theme",
    "packages": [
      "interaktiv.basetiles",
      "interaktiv.tile_collapse",
      "interaktiv.tile_contact",
      "interaktiv.tile_icon",
      "interaktiv.tile_image",
      "interaktiv.tile_subheadline",
      "interaktiv.tile_table",
      "interaktiv.tile_text",
      "interaktiv.tile_news",
      "interaktiv.tile_slider",
      "interaktiv.tile_files",
      "interaktiv.tile_timeline",
      "interaktiv.tile_button",
      "interaktiv.tile_breadcrumbs",
      "interaktiv.tile_video",
      "interaktiv.tile_spacer",
      "interaktiv.tilespage_versioning",
      "interaktiv.tile_map",
      "interaktiv.tile_audio",
      "interaktiv.tile_iframe",
      "interaktiv.tile_forms",
      "interaktiv.tilepage_versioning",
      "interaktiv.fonts",
      "interaktiv.image_focus",
      "interaktiv.tile_tags",
      "interaktiv.tile_rss",
      "interaktiv.migrator",
      "interaktiv.layout",
      "interaktiv.framework",
      "interaktiv.tile_line",
      "interaktiv.tile_collection",
      "interaktiv.theme",
      "graffiti.tile_listing",
      "graffiti.tile_search",
      "graffiti.tile_dashboard",
      "graffiti.tile_view",
      "graffiti.tile_tabs",
      "interaktiv.workingcopy"
    ],
    "javascript_lib_files": [
      "<%= paths.node %>bootstrap/dist/js/bootstrap.js",
      "<%= paths.node %>bootstrap/js/tab.js",
      "<%= paths.node %>bootstrap-select/dist/js/bootstrap-select.js",
      "<%= paths.node %>bootstrap-select/dist/js/i18n/defaults-de_DE.js",
      "<%= paths.node %>bootstrap-typeahead/bootstrap-typeahead.js",
      "<%= paths.node %>tinyColorPicker/jqColorPicker.min.js",
      "<%= paths.node %>wow.js/dist/wow.js",
      "<%= paths.node %>rellax/rellax.js",
      "<%= paths.node %>dropzone/dist/dropzone.js",
      "<%= paths.node %>slick-carousel/slick/slick.js",
      "<%= paths.node %>jquery-ui/ui/version.js",
      "<%= paths.node %>jquery-ui/ui/data.js",
      "<%= paths.node %>jquery-ui/ui/plugin.js",
      "<%= paths.node %>jquery-ui/ui/safe-active-element.js",
      "<%= paths.node %>jquery-ui/ui/safe-blur.js",
      "<%= paths.node %>jquery-ui/ui/scroll-parent.js",
      "<%= paths.node %>jquery-ui/ui/widget.js",
      "<%= paths.node %>jquery-ui/ui/widgets/mouse.js",
      "<%= paths.node %>jquery-ui/ui/widgets/draggable.js",
      "<%= paths.node %>jquery-ui/ui/widgets/droppable.js",
      "<%= paths.node %>jquery-ui/ui/widgets/sortable.js",
      "<%= paths.node %>ajaxq/ajaxq.js",
      "<%= paths.node %>tablesorter/dist/js/jquery.tablesorter.js",
      "<%= paths.node %>toastr/toastr.js",
      "<%= paths.node %>blueimp-tmpl/js/tmpl.min.js",
      "<%= paths.node %>jquery-ui/ui/disable-selection.js",
      "<%= paths.node %>jquery-ui/ui/widgets/resizable.js",
      "<%= paths.node %>leaflet/dist/leaflet.js",
      "<%= paths.node %>leaflet-path-drag/dist/L.Path.Drag-src.js",
      "<%= paths.node %>leaflet-path-transform/dist/L.Path.Transform-src.js",
      "<%= paths.node %>leaflet-geosearch/dist/bundle.min.js",
      "<%= paths.node %>jquery-lazy/jquery.lazy.js",
      "<%= paths.node %>jquery.cookie/jquery.cookie.js"
    ],
    "javascript_direct_files": []
  }
}

<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="graffiti.tile_listing">

    <i18n:registerTranslations directory="locales" />

    <include file="permissions.zcml" />
    <include package="graffiti.tile_listing.adapters"/>
    <include package="graffiti.tile_listing.views"/>

    <genericsetup:registerProfile
        name="default"
        title="graffiti.tile_listing"
        directory="profiles/default"
        description="Installs the graffiti.tile_listing package"
        provides="Products.GenericSetup.interfaces.EXTENSION"
        post_handler="graffiti.tile_listing.setuphandlers.setup_after"
    />

    <genericsetup:registerProfile
        name="uninstall"
        title="graffiti.tile_listing"
        directory="profiles/uninstall"
        description="Uninstalls the graffiti.tile_listing package"
        provides="Products.GenericSetup.interfaces.EXTENSION"
        post_handler="graffiti.tile_listing.setuphandlers.uninstall_after"
    />

    <utility
            factory=".setuphandlers.HiddenProfiles"
            name="graffiti.tile_listing-hiddenprofiles"
    />

</configure>

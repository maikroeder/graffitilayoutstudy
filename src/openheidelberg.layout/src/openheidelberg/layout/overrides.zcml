<configure
        xmlns="http://namespaces.zope.org/zope"
        xmlns:browser="http://namespaces.zope.org/browser">

    <!-- Same registration as in interaktiv.basetiles/views/configure.zcml, with a subclass that
         adds the body class layout-<id>. -->
    <browser:page
            for="interaktiv.basetiles.contenttypes.tilepage.ITilePage"
            name="plone_layout"
            class="openheidelberg.layout.layout_policy.OpenHeidelbergTilePageLayoutPolicy"
            permission="zope.Public"
            layer="interaktiv.basetiles.interfaces.IInteraktivBasetilesLayer"
            allowed_interface="plone.app.layout.globals.interfaces.ILayoutPolicy"
    />

    <!-- All other content: the policy of plone.app.layout (registered there for "*") plus the layout class. The
         more specific registration above, for TilePages, is still preferred for TilePages. -->
    <browser:page
            for="*"
            name="plone_layout"
            class="openheidelberg.layout.layout_policy.OpenHeidelbergLayoutPolicy"
            permission="zope.Public"
            layer="openheidelberg.layout.interfaces.IOpenHeidelbergLayoutLayer"
            allowed_interface="plone.app.layout.globals.interfaces.ILayoutPolicy"
    />

</configure>

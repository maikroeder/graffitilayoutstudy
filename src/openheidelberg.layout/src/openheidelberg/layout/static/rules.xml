<?xml version="1.0" encoding="utf-8"?>
<!--
  Dispatcher. Exactly one branch applies to a page; the conditions are exclusive:

    iframe view                         -> interaktiv.theme (unchanged)
    site-search-layout, view mode       -> layouts/site-search-layout
    site-layout switched on (parameter site_layout_enabled, see manifest.cfg), not edit mode
                                        -> layouts/site-layout
    site-layout switched on, edit mode  -> layouts/site-edit-layout (frame of the site around the editor)
    everything else                     -> interaktiv.theme (unchanged)

  The body classes layout-<id> and view-mode / edit-mode are set on TilePages by layout_policy.py
  and interaktiv.basetiles. Pages that are not TilePages carry none of them.

  Diazo has no "else", so the last two branches repeat the negation of what the ones before them test.
-->
<rules xmlns="http://namespaces.plone.org/diazo"
       xmlns:css="http://namespaces.plone.org/diazo/css"
       xmlns:xi="http://www.w3.org/2001/XInclude">

    <rules css:if-not-content=".iframe-view">

        <rules css:if-content="body.layout-site-search-layout.view-mode">
            <xi:include href="++theme++openheidelberg.layout/layouts/site-search-layout/rules.xml" />
        </rules>

        <rules css:if-not-content="body.layout-site-search-layout.view-mode">

            <rules if-content="string($site_layout_enabled) = '1'" css:if-not-content="body.edit-mode">
                <xi:include href="++theme++openheidelberg.layout/layouts/site-layout/rules.xml" />
            </rules>

            <rules if-content="string($site_layout_enabled) = '1'" css:if-content="body.edit-mode">
                <xi:include href="++theme++openheidelberg.layout/layouts/site-edit-layout/rules.xml" />
            </rules>

            <rules if-content="string($site_layout_enabled) != '1'">
                <xi:include href="++theme++interaktiv.theme/rules.xml" />
            </rules>

        </rules>
    </rules>

    <rules css:if-content=".iframe-view">
        <xi:include href="++theme++interaktiv.theme/rules.xml" />
    </rules>

</rules>

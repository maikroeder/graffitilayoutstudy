<?xml version="1.0" encoding="utf-8"?>
<!--
  Control panels: the other sections. The slim header has no personal tools and the portlet columns are left out. The
  way back to the Site Setup is in the breadcrumbs (regions/breadcrumbs.xml); below them this bar keeps the Site Setup
  portlet that Plone puts in the right column of every control panel (not on the overview itself, which carries it as
  its content), the list of all sections, in a closed <details>, so that the other panels are one click away.
-->
<rules xmlns="http://namespaces.plone.org/diazo"
       xmlns:css="http://namespaces.plone.org/diazo/css"
       xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

    <before css:theme="#main-container" css:if-content="#portal-column-two .portletSiteSetup" method="raw">
        <nav class="container site-setup-bar" aria-label="Site Setup">
            <details class="site-setup-all">
                <summary>All settings</summary>
                <xsl:copy-of css:select="#portal-column-two .portletSiteSetup" />
            </details>
        </nav>
    </before>

</rules>

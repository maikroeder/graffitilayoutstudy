<?xml version="1.0" encoding="utf-8"?>
<!--
  Breadcrumbs. plone.path_bar sits in the same viewlet manager as the above-content area.

  Control panels (pages with the Site Setup portlet in the right column) have an empty trail: it is built here as
  Home / Site Setup / <title of the page>, in the markup of the trail of the theme. The link to the Site Setup is the
  one of the portlet, with the id and class that the control panel templates of Plone give it (a#setup-link.link-parent).
-->
<rules xmlns="http://namespaces.plone.org/diazo"
       xmlns:css="http://namespaces.plone.org/diazo/css"
       xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

    <replace css:theme-children="#company-content .breadcrumbs" css:content-children="#portal-breadcrumbs"
             css:if-not-content="#portal-column-two .portletSiteSetup, #content a#setup-link, body.viewpermission-set-own-properties, body.viewpermission-set-own-password" />

    <replace css:theme-children="#company-content .breadcrumbs" css:if-content="#portal-column-two .portletSiteSetup, #content a#setup-link"
             method="raw">
        <xsl:variable name="setup-link"
                      select="(//*[@id='portal-column-two']//*[contains(@class, 'portletSiteSetup')]//a[contains(@href, '@@overview-controlpanel')] | //*[@id='content']//a[@id='setup-link'])[1]" />
        <div class="container">
            <ol aria-labelledby="breadcrumbs-you-are-here">
                <li id="breadcrumbs-home">
                    <a href="{//a[@id='portal-logo']/@href}"><i class="interaktiv-icon-basetilestheme-breadcrumb"></i></a>
                </li>
                <li id="breadcrumbs-1">
                    <a id="setup-link" class="link-parent" href="{$setup-link/@href}">Site Setup</a>
                </li>
                <li id="breadcrumbs-2">
                    <span id="breadcrumbs-current"><xsl:value-of select="normalize-space((//h1[contains(@class, 'documentFirstHeading')])[1])" /></span>
                </li>
            </ol>
        </div>
    </replace>

    <!-- The personal pages of a user (personal information, preferences, password): Home / <title of the page> -->
    <replace css:theme-children="#company-content .breadcrumbs" css:if-content="body.viewpermission-set-own-properties, body.viewpermission-set-own-password" method="raw">
        <div class="container">
            <ol aria-labelledby="breadcrumbs-you-are-here">
                <li id="breadcrumbs-home">
                    <a href="{//a[@id='portal-logo']/@href}"><i class="interaktiv-icon-basetilestheme-breadcrumb"></i></a>
                </li>
                <li id="breadcrumbs-1">
                    <span id="breadcrumbs-current"><xsl:value-of select="normalize-space((//h1[contains(@class, 'documentFirstHeading')])[1])" /></span>
                </li>
            </ol>
        </div>
    </replace>

    <!-- The control panel templates repeat the link as a button above the heading; it is now the middle crumb. -->
    <drop css:content="#content a#setup-link" css:if-content="#portal-column-two .portletSiteSetup, #content a#setup-link" />

</rules>

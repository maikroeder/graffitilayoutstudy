<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout "site-layout": the look of every page that main_template renders, except the special pages and edit
  mode: slim header, breadcrumbs, search bar, title, content, footer, in the look of /exploring (site.css).
-->
<rules xmlns="http://namespaces.plone.org/diazo"
       xmlns:css="http://namespaces.plone.org/diazo/css"
       xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
       xmlns:xi="http://www.w3.org/2001/XInclude">

    <notheme css:if-not-content="#visual-portal-wrapper" />
    <theme href="++theme++openheidelberg.layout/site.html" />

    <xi:include href="++theme++openheidelberg.layout/frame.xml" />
    <xi:include href="++theme++openheidelberg.layout/regions/common.xml" />
    <xi:include href="++theme++openheidelberg.layout/regions/header-slim.xml" />
    <xi:include href="++theme++openheidelberg.layout/regions/statusmessage.xml" />
    <xi:include href="++theme++openheidelberg.layout/regions/breadcrumbs.xml" />
    <!-- search bar between breadcrumbs and title -->
    <xi:include href="++theme++openheidelberg.layout/regions/search-bar.xml" />
    <!-- tile pages: the tiles page view leaves out the title of Plone, so it comes from the <title> of the page -->
    <before css:theme="#main-container" css:if-content="body.is-tilepage">
        <div class="container tiles-page-title">
            <h1><xsl:value-of select="normalize-space(substring-before(concat(//title, ' —'), ' —'))" /></h1>
        </div>
    </before>
    <xi:include href="++theme++openheidelberg.layout/regions/content.xml" />
    <xi:include href="++theme++openheidelberg.layout/regions/footer.xml" />

</rules>

<?xml version="1.0"?>
<object name="TileTabs"
        meta_type="Dexterity FTI"
        i18n:domain="graffiti.tile_tabs"
        xmlns:i18n="http://xml.zope.org/namespaces/i18n">
    <property name="title" i18n:translate="">label_TileTabs</property>
    <property name="description" i18n:translate="">help_TileTabs</property>
    <property name="icon_expr">
    </property>
    <property name="factory">TileTabs</property>
    <property name="add_view_expr">string:${folder_url}/++add++TileTabs</property>
    <property name="link_target"/>
    <property name="immediate_view">view</property>
    <property name="global_allow">False</property>
    <property name="filter_content_types">True</property>
    <property name="allowed_content_types"/>
    <property name="allow_discussion">False</property>
    <property name="default_view">view</property>
    <property name="view_methods">
        <element value="view"/>
    </property>
    <property name="default_view_fallback">False</property>
    <property name="add_permission">cmf.AddPortalContent</property>
    <property name="klass">graffiti.tile_tabs.contenttype.TileTabs</property>
    <property name="schema">graffiti.tile_tabs.contenttype.ITileTabs</property>
    <!-- dotted interface paths on purpose: interaktiv.basetiles v10 (Plone 5.2) only knows these,
         v29 (Plone 6) still resolves them and maps them to the short names -->
    <property name="behaviors">
        <element value="plone.app.content.interfaces.INameFromTitle" />
        <element value="interaktiv.basetiles.behaviors.background.IBackgroundBehavior" />
        <element value="interaktiv.basetiles.behaviors.padding.IPaddingBehavior" />
        <element value="interaktiv.basetiles.behaviors.vertical_align.IVerticalAligmentBehavior" />
        <element value="interaktiv.basetiles.behaviors.anchor.IAnchorBehavior" />
    </property>
    <property name="model_source"/>
    <property name="model_file"/>
    <alias from="(Default)" to="(dynamic view)"/>
    <alias from="edit" to="@@edit"/>
    <alias from="sharing" to="@@sharing"/>
    <alias from="view" to="(selected layout)"/>
    <action title="View" action_id="view" category="object" condition_expr=""
            description="" icon_expr="" link_target=""
            url_expr="string:${object_url}"
            visible="True">
        <permission value="View"/>
    </action>
    <action title="Edit" action_id="edit" category="object" condition_expr=""
            description="" icon_expr="" link_target=""
            url_expr="string:${object_url}/edit" visible="True">
        <permission value="Modify portal content"/>
    </action>
</object>

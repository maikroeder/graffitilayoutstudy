<div class="graffiti-pdfcheck-checks" i18n:domain="graffiti.pdfcheck" tal:attributes="id view/id">
  <link rel="stylesheet" tal:attributes="href view/css_url" />
  <table class="listing">
    <thead>
      <tr>
        <th i18n:translate="checks_column_check">Check</th>
        <th i18n:translate="checks_column_name">Name</th>
        <th i18n:translate="checks_column_function">Python function</th>
      </tr>
    </thead>
    <tbody>
      <tr tal:repeat="item view/rows">
        <td>
          <label tal:attributes="for item/id">
            <input type="checkbox"
                   tal:attributes="id item/id;
                                   name item/name;
                                   value item/value;
                                   class view/klass;
                                   checked python:'checked' if item['checked'] else None" />
            <span tal:replace="item/label">Open the file</span>
          </label>
        </td>
        <td><code tal:content="item/check_name">open</code></td>
        <td><code tal:content="item/function">graffiti.pdfcheck.checks.check_open</code></td>
      </tr>
    </tbody>
  </table>
  <input name="field-empty-marker" type="hidden" value="1" tal:attributes="name string:${view/name}-empty-marker" />
</div>

    <!-- replaces the upload utility of interaktiv.basetiles, see utilities/upload_file.py -->
    <utility
        factory=".utilities.upload_file.UploadFileUtilityWithoutPreviewError"
        provides="interaktiv.basetiles.utilities.upload_file.IUploadFileUtility"
    />

</configure>

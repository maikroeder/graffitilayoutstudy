<?xml version="1.0"?>
<object name="portal_actions" meta_type="Plone Actions Tool"
        xmlns:i18n="http://xml.zope.org/namespaces/i18n">
    <object name="object_buttons" meta_type="CMF Action Category">

        <object name="workingcopy_checkin" meta_type="CMF Action" i18n:domain="plone">
            <property name="title" i18n:translate="">Arbeitskopie mit Original austauschen</property>
            <property name="description" i18n:translate="">
            </property>
            <property name="url_expr">string:${object_url}/@@arbeitskopie-mit-original-austauschen</property>
            <property name="icon_expr">string:${portal_url}/++resource++checkout.png</property>
            <property name="available_expr">python:path('object/@@workingcopy_control').checkin_allowed()</property>
            <property name="permissions">
                <element value="View"/>
            </property>
            <property name="visible">True</property>
        </object>

        <object name="workingcopy_checkout" meta_type="CMF Action" i18n:domain="plone">
            <property name="title" i18n:translate="">Arbeitskopie erstellen</property>
            <property name="description" i18n:translate="">
            </property>
            <property name="url_expr">string:${object_url}/@@arbeitskopie-erstellen</property>
            <property name="icon_expr">string:${portal_url}/++resource++checkout.png</property>
            <property name="available_expr">python:path('object/@@workingcopy_control').checkout_allowed()</property>
            <property name="permissions">
                <element value="View"/>
            </property>
            <property name="visible">True</property>
        </object>

        <object name="workingcopy_checkout_cancel" meta_type="CMF Action" i18n:domain="plone">
            <property name="title" i18n:translate="">Arbeitskopie verwerfen</property>
            <property name="description" i18n:translate="">
            </property>
            <property name="url_expr">string:${object_url}/@@arbeitskopie-verwerfen</property>
            <property name="icon_expr">string:${portal_url}/++resource++cancel-checkout.png</property>
            <property name="available_expr">python:path('object/@@workingcopy_control').cancel_allowed()</property>
            <property name="permissions">
                <element value="Modify portal content"/>
            </property>
            <property name="visible">True</property>
        </object>

    </object>
</object>
